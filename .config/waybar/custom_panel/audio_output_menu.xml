<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <object class="GtkAdjustment" id="volume_adjustment">
        <property name="lower">0</property>
        <property name="upper">100</property>
        <property name="value">50</property>
        <property name="step-increment">1</property>
        <property name="page-increment">10</property>
    </object>

    <object class="GtkMenu" id="menu">
        <child>
            <object class="GtkMenuItem" id="volume_slider_item">
                <property name="sensitive">true</property>
                <child>
                    <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="margin-start">8</property>
                        <property name="margin-end">8</property>
                        <property name="margin-top">4</property>
                        <property name="margin-bottom">4</property>
                        <child>
                            <object class="GtkLabel">
                                <property name="label"></property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkScale" id="volume_slider">
                                <property name="orientation">horizontal</property>
                                <property name="adjustment">volume_adjustment</property>
                                <property name="draw-value">true</property>
                                <property name="value-pos">right</property>
                                <property name="width-request">180</property>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>

        <child>
            <object class="GtkMenuItem" id="output_select_item">
                <property name="sensitive">true</property>
                <child>
                    <object class="GtkComboBoxText" id="output_select">
                        <property name="width-request">230</property>
                        <items>
                            <item translatable="yes" id="internal-speakers">Altavoces internos</item>
                            <item translatable="yes" id="headphones">Auriculares</item>
                            <item translatable="yes" id="bluetooth">Bluetooth</item>
                            <item translatable="yes" id="hdmi">HDMI</item>
                            <item translatable="yes" id="usb">USB</item>
                        </items>
                    </object>
                </child>
            </object>
        </child>

        <child>
            <object class="GtkMenuItem" id="volume">
                <property name="label">  Elegir volumen (0–100%)…</property>
            </object>
        </child>
        <child>
            <object class="GtkMenuItem" id="output">
                <property name="label">󰓃  Elegir dónde escuchar el sonido…</property>
            </object>
        </child>
        <child>
            <object class="GtkSeparatorMenuItem" id="separator"/>
        </child>
        <child>
            <object class="GtkMenuItem" id="volume_down">
                <property name="label">  Bajar 5%</property>
            </object>
        </child>
        <child>
            <object class="GtkMenuItem" id="volume_up">
                <property name="label">  Subir 5%</property>
            </object>
        </child>
        <child>
            <object class="GtkMenuItem" id="mute">
                <property name="label">  Silenciar o activar el sonido</property>
            </object>
        </child>
    </object>
</interface>
